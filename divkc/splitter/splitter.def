BootStrap: docker
From: ubuntu:22.04

%files
    ./ /splitter
    ../D4/wrapper /wrapper

%post
    echo "setup start"
    apt-get -y update
    apt-get -y install ninja-build libboost-program-options-dev g++ make

    cd splitter
    g++ gen.cpp -o gen
    ./gen
    ninja clean
    ninja

    cd /wrapper
    make clean
    make

    ls
    echo "setup done"

%runscript
    /wrapper/wrap 64000 1800 /splitter/build/splitter "$@"
