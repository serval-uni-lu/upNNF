BootStrap: docker
From: ubuntu:22.04

%files
    ./d4d /d4
    ./wrapper /wrapper

%post
    echo "setup start"
    apt-get -y update

    #apt-get -y full-upgrade
    apt-get -y install tzdata
    apt-get -y install g++ make zlib1g-dev libboost-dev libgmp-dev libgmpxx4ldbl

    # apt-get -y install zlib1g-dev libboost-dev libgmp-dev libgmpxx4ldbl

    cd /d4
    make clean
    make -j8

    cd /wrapper
    make clean
    make

    chmod 755 /d4/d4
    chmod 755 /d4
    chmod 755 /wrapper/wrap
    chmod 755 /wrapper

%runscript
    /wrapper/wrap 16000 1800 /d4/d4 "$@"
